{
  "tun": {
    "enable": true,
    "device": "contract-tun",
    "mtu": 1500,
    "auto-route": true,
    "stack": "system",
    "recvmsgx": true,
    "sendmsgx": true,
    "dns-mode": "native",
    "dns-hijack": ["any:53"],
    "route-address": ["10.0.0.0/8"],
    "strict-route": true,
    "disable-icmp-forwarding": true,
    "endpoint-independent-nat": true,
    "congestion-controller": "bbr",
    "auto-detect-interface": true,
    "gso": true,
    "gso-max-size": 65536,
    "multi-queue": true,
    "inet6-address": ["fdfe:dcba:9876::1/126"],
    "loopback-address": ["10.7.0.1"],
    "route-exclude-address": ["192.168.0.0/16"],
    "route-address-set": ["ruleset-route"],
    "route-exclude-address-set": ["ruleset-bypass"],
    "auto-redirect": true,
    "auto-redirect-input-mark": 8227,
    "auto-redirect-output-mark": 8228,
    "auto-redirect-iproute2-fallback-rule-index": 32768,
    "iproute2-table-index": 2022,
    "iproute2-rule-index": 9000,
    "include-interface": ["eth0"],
    "exclude-interface": ["wlan0"],
    "include-uid": [1000],
    "include-uid-range": ["1000:9999"],
    "exclude-uid": [1001],
    "exclude-uid-range": ["2000:2999"],
    "exclude-src-port": [5353],
    "exclude-src-port-range": ["10000:20000"],
    "exclude-dst-port": [8080],
    "exclude-dst-port-range": ["30000:40000"],
    "include-mac-address": ["00:11:22:33:44:55"],
    "exclude-mac-address": ["66:77:88:99:aa:bb"],
    "udp-timeout": 300,
    "icmp-timeout": 30
  },
  "mixed-port": 7890,
  "allow-lan": true,
  "find-process-mode": "always",
  "mode": "rule",
  "log-level": "info",
  "ipv6": true,
  "tcp-concurrent": true,
  "external-controller": "127.0.0.1:9090",
  "secret": "contract-secret",
  "unified-delay": true,
  "authentication": ["user:password"],
  "geo-auto-update": true,
  "geo-update-interval": 12
}
